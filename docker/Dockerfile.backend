FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PGF_PATH=/app/runtime/semantik_architect.pgf
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY app ./app
COPY nlg ./nlg
COPY discourse ./discourse
COPY registry ./registry
COPY utils ./utils
RUN pip install --no-cache-dir .[api,gf]
COPY runtime ./runtime
COPY schemas ./schemas
CMD ["uvicorn", "app.adapters.api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
