{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantik-architect:schema:capability-profile:1.0",
  "title": "Capability Profile v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "required_operations",
    "required_features",
    "required_block_kinds",
    "test_suite_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]+$"
      }
    },
    "required_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "required_block_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "utterance",
          "question",
          "list",
          "label_value",
          "notice",
          "heading"
        ]
      }
    },
    "register_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "locale_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "test_suite_ref": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
