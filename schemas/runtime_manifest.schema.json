{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantik-architect:schema:runtime-manifest:1.0",
  "title": "RuntimeSet Manifest v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_set_id",
    "sa_version_range",
    "sa_gf_contract_version",
    "artifacts",
    "capability_manifest_ref",
    "conformance_evidence_refs",
    "status",
    "capability_manifest_sha256",
    "conformance_evidence_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "runtime_set_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sa_version_range": {
      "type": "string"
    },
    "sa_gf_contract_version": {
      "type": "string"
    },
    "gf_version": {
      "type": "string"
    },
    "rgl_identity": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_type",
          "artifact_id",
          "sha256"
        ],
        "properties": {
          "artifact_type": {
            "enum": [
              "grammar",
              "lexical",
              "locale",
              "other"
            ]
          },
          "artifact_id": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "path": {
            "type": "string"
          },
          "license_ref": {
            "type": "string"
          },
          "provenance_ref": {
            "type": "string"
          }
        }
      }
    },
    "capability_manifest_ref": {
      "type": "string"
    },
    "conformance_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "capability_manifest_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "conformance_evidence_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Fa-f0-9]{64}$"
      }
    }
  }
}
