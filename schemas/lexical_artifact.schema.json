{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantik-architect:schema:lexical-artifact:1.1",
  "title": "Lexical Artifact v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lexicon_id",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "lexicon_id": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "enum": [
        "request_override",
        "domain",
        "project",
        "wikidata",
        "gf_generic"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "lexical_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "const": "1.0"
        },
        "precedence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "request_override",
              "domain",
              "project",
              "wikidata",
              "gf_generic"
            ]
          }
        },
        "default_source_kind": {
          "enum": [
            "request_override",
            "domain",
            "project",
            "wikidata",
            "gf_generic"
          ]
        },
        "equal_precedence_conflict": {
          "const": "fail"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_ref",
          "language",
          "lexical_ref"
        ],
        "properties": {
          "semantic_ref": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "lexical_ref": {
            "type": "string"
          },
          "binding_kind": {
            "enum": [
              "gf_expr",
              "literal",
              "lexeme_ref"
            ]
          },
          "category": {
            "type": "string"
          },
          "source_kind": {
            "enum": [
              "request_override",
              "domain",
              "project",
              "wikidata",
              "gf_generic"
            ]
          },
          "use_for": {
            "enum": [
              "knowledge",
              "binding",
              "both"
            ]
          },
          "source_ref": {
            "type": "string"
          },
          "sense_ref": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
