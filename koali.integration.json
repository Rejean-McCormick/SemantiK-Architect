{
  "schemaVersion": 1,
  "productId": "semantik_architect",
  "owner": "SemantiK Architect",
  "variables": {
    "webPort": {
      "type": "port",
      "env": "KOALI_SEMANTIK_ARCHITECT_PORT",
      "default": 4304
    },
    "apiPort": {
      "type": "port",
      "env": "KOALI_SEMANTIK_ARCHITECT_BACKEND_PORT",
      "default": 8304
    }
  },
  "surface": {
    "embedBase": "http://127.0.0.1:${webPort}/semantik_architect"
  },
  "processes": [
    {
      "id": "api",
      "cwd": ".",
      "command": {
        "win32": "pwsh.exe",
        "default": "pwsh"
      },
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "koali/start-api.ps1",
        "-Port",
        "${apiPort}"
      ],
      "env": {
        "PGF_PATH": "${repo}/runtime/semantik_architect.pgf"
      },
      "probeId": "api"
    },
    {
      "id": "web",
      "cwd": "architect_frontend",
      "command": "npm",
      "shell": {
        "win32": true,
        "default": false
      },
      "args": [
        "run",
        "dev",
        "--",
        "--hostname",
        "127.0.0.1",
        "--port",
        "${webPort}"
      ],
      "env": {
        "PORT": "${webPort}",
        "NEXT_PUBLIC_ARCHITECT_API_BASE_URL": "http://127.0.0.1:${apiPort}/api/v1",
        "NEXT_PUBLIC_ARCHITECT_BASE_PATH": "/semantik_architect"
      },
      "probeId": "web"
    }
  ],
  "probes": [
    {
      "id": "api",
      "url": "http://127.0.0.1:${apiPort}/health/ready",
      "required": true,
      "statuses": [
        200
      ],
      "timeoutMs": 3000
    },
    {
      "id": "web",
      "url": "http://127.0.0.1:${webPort}/semantik_architect",
      "required": true,
      "statuses": [
        200,
        307,
        308
      ],
      "timeoutMs": 2500
    }
  ]
}
