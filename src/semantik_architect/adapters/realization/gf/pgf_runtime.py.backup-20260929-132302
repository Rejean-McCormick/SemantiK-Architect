from __future__ import annotations

import asyncio
import logging
import os
import re
import shutil
import subprocess
import tempfile
import threading
from pathlib import Path
from typing import Any

try:
    import pgf  # type: ignore
except Exception as exc:  # pragma: no cover - environment dependent
    pgf = None  # type: ignore[assignment]
    _PGF_IMPORT_ERROR: Exception | None = exc
else:
    _PGF_IMPORT_ERROR = None

logger = logging.getLogger(__name__)

_GF_EXECUTABLE_ENV = "SEMANTIK_GF_EXECUTABLE"
_LANGUAGES_RE = re.compile(r"Languages:\s*([^\r\n]+)", re.IGNORECASE)


class PgfRuntimeUnavailableError(RuntimeError):
    """Raised when the configured PGF runtime cannot be loaded."""


class PgfConcreteLanguageNotFoundError(LookupError):
    """Raised when a concrete grammar is not present in the loaded PGF."""


def _decode_gf_output(raw: bytes) -> str:
    """GF emits UTF-8 by default; preserve diagnostics if decoding is imperfect."""
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return raw.decode("utf-8", errors="replace")


class PgfRuntime:
    """Thread-safe, async-safe consumer of one precompiled PGF artifact.

    Preferred backend: the Python ``pgf`` binding.

    Offline fallback backend: the official GF executable, enabled only when
    ``SEMANTIK_GF_EXECUTABLE`` explicitly points to an existing ``gf``/``gf.exe``.
    The CLI backend still consumes the exact precompiled ``grammar.pgf`` and
    performs real GF linearization; it does not synthesize or substitute text.
    """

    def __init__(self, pgf_path: str | Path) -> None:
        self.pgf_path = Path(pgf_path).expanduser().resolve()
        self._grammar: Any | None = None
        self._backend: str | None = None
        self._gf_executable: str | None = None
        self._concrete_languages: list[str] = []
        self._async_lock = asyncio.Lock()
        self._thread_lock = threading.Lock()
        self.last_error: str | None = None

    @property
    def grammar(self) -> Any | None:
        """Return the Python-binding grammar object when that backend is active.

        The CLI backend intentionally has no synthetic grammar proxy. Callers
        should use ``linearize``/``get_concrete_languages`` instead.
        """
        if self._backend is None:
            try:
                asyncio.get_running_loop()
            except RuntimeError:
                self._load_sync()
        return self._grammar

    @property
    def backend(self) -> str | None:
        if self._backend is None:
            try:
                asyncio.get_running_loop()
            except RuntimeError:
                self._load_sync()
        return self._backend

    def _resolve_gf_executable(self) -> str | None:
        configured = os.environ.get(_GF_EXECUTABLE_ENV, "").strip()
        if not configured:
            return None
        candidate = Path(configured).expanduser()
        if candidate.is_file():
            return str(candidate.resolve())
        return shutil.which(configured)

    def _run_gf_cli(self, commands: list[str], *, cwd: Path | None = None) -> tuple[int, str]:
        if not self._gf_executable:
            raise PgfRuntimeUnavailableError("GF CLI backend is not configured.")
        script = "\n".join(["se utf8", *commands, "q", ""])
        try:
            cp = subprocess.run(
                [self._gf_executable, str(self.pgf_path)],
                cwd=str(cwd) if cwd else None,
                input=script.encode("utf-8"),
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=30,
                shell=False,
                check=False,
            )
        except (OSError, subprocess.SubprocessError) as exc:
            raise PgfRuntimeUnavailableError(f"GF CLI execution failed: {exc}") from exc
        return cp.returncode, _decode_gf_output(cp.stdout or b"")

    def _load_sync(self) -> None:
        if self._backend is not None:
            return
        with self._thread_lock:
            if self._backend is not None:
                return
            if not self.pgf_path.is_file():
                self.last_error = f"PGF artifact not found: {self.pgf_path}"
                return

            if pgf is not None:
                try:
                    self._grammar = pgf.readPGF(str(self.pgf_path))
                    self._concrete_languages = sorted(self._grammar.languages.keys())
                    self._backend = "python_pgf"
                    self.last_error = None
                    logger.info(
                        "PGF loaded: backend=python_pgf path=%s concrete_languages=%s",
                        self.pgf_path,
                        self._concrete_languages,
                    )
                    return
                except Exception as exc:
                    # If a Python binding exists but cannot consume this artifact,
                    # do not silently switch engines: fail closed on that explicit
                    # runtime and surface the actual error.
                    self._grammar = None
                    self.last_error = f"Could not load PGF artifact with Python binding: {exc}"
                    return

            executable = self._resolve_gf_executable()
            if executable is None:
                self.last_error = (
                    f"PGF Python binding unavailable: {_PGF_IMPORT_ERROR}; "
                    f"{_GF_EXECUTABLE_ENV} is not configured"
                )
                return

            self._gf_executable = executable
            try:
                rc, output = self._run_gf_cli(["pg -langs"])
            except PgfRuntimeUnavailableError as exc:
                self.last_error = str(exc)
                return
            if rc != 0:
                self.last_error = f"GF CLI could not load PGF artifact (rc={rc}): {output[-2000:]}"
                return
            match = _LANGUAGES_RE.search(output)
            if not match:
                self.last_error = f"GF CLI did not report concrete languages: {output[-2000:]}"
                return
            languages = [item for item in match.group(1).strip().split() if item]
            if not languages:
                self.last_error = "GF CLI reported no concrete languages."
                return
            self._concrete_languages = sorted(dict.fromkeys(languages))
            self._backend = "gf_cli"
            self.last_error = None
            logger.info(
                "PGF loaded: backend=gf_cli executable=%s path=%s concrete_languages=%s",
                executable,
                self.pgf_path,
                self._concrete_languages,
            )

    async def ensure_loaded(self) -> None:
        if self._backend is not None:
            return
        async with self._async_lock:
            if self._backend is None:
                await asyncio.to_thread(self._load_sync)
        if self._backend is None:
            raise PgfRuntimeUnavailableError(
                self.last_error or "PGF runtime is unavailable."
            )

    async def status(self) -> dict[str, Any]:
        try:
            await self.ensure_loaded()
        except PgfRuntimeUnavailableError:
            pass
        return {
            "loaded": self._backend is not None,
            "backend": self._backend,
            "pgf_path": str(self.pgf_path),
            "gf_executable": self._gf_executable,
            "error": self.last_error,
            "concrete_languages": list(self._concrete_languages),
        }

    async def get_concrete_languages(self) -> list[str]:
        await self.ensure_loaded()
        return list(self._concrete_languages)

    async def health_check(self) -> bool:
        try:
            await self.ensure_loaded()
            return True
        except PgfRuntimeUnavailableError:
            return False

    async def reload(self) -> None:
        async with self._async_lock:
            with self._thread_lock:
                self._grammar = None
                self._backend = None
                self._gf_executable = None
                self._concrete_languages = []
                self.last_error = None
        await self.ensure_loaded()

    def resolve_concrete_name(self, concrete_language: str) -> str | None:
        if self._backend is None:
            self._load_sync()
        if self._backend is None:
            return None
        requested = str(concrete_language or "").strip()
        if requested in self._concrete_languages:
            return requested
        requested_folded = requested.casefold()
        for name in self._concrete_languages:
            if name.casefold() == requested_folded:
                return name
        return None

    def parse(self, sentence: str, concrete_language: str):
        if self._backend is None:
            self._load_sync()
        if self._backend is None:
            raise PgfRuntimeUnavailableError(
                self.last_error or "PGF runtime is unavailable."
            )
        concrete = self.resolve_concrete_name(concrete_language)
        if concrete is None:
            raise PgfConcreteLanguageNotFoundError(concrete_language)
        if self._backend != "python_pgf" or self._grammar is None:
            raise PgfRuntimeUnavailableError(
                "Parsing requires the Python pgf binding; the GF CLI backend is linearization-only."
            )
        return self._grammar.languages[concrete].parse(sentence)

    def _linearize_cli(self, expr: str, concrete: str) -> str:
        if any(ch in expr for ch in "\r\n"):
            raise ValueError("GF expression must be a single line for the CLI backend.")
        # Avoid parsing the interactive shell transcript. GF applies its text
        # unlexer so punctuation is formatted without depending on Prelude.BIND,
        # then write_file emits only the linearized value to a UTF-8 file.
        with tempfile.TemporaryDirectory(prefix="semantik-gf-") as tmp:
            tmp_dir = Path(tmp)
            output_name = "linearized.txt"
            command = f'l -unlextext -lang={concrete} {expr} | wf -file="{output_name}"'
            rc, transcript = self._run_gf_cli([command], cwd=tmp_dir)
            output_path = tmp_dir / output_name
            if rc != 0 or not output_path.is_file():
                raise PgfRuntimeUnavailableError(
                    f"GF CLI linearization failed (rc={rc}): {transcript[-2000:]}"
                )
            raw = output_path.read_bytes()
            text = _decode_gf_output(raw).strip()
            if not text:
                raise PgfRuntimeUnavailableError(
                    f"GF CLI returned no linearization: {transcript[-2000:]}"
                )
            return text

    def linearize(self, expr: Any, concrete_language: str) -> str:
        if self._backend is None:
            self._load_sync()
        if self._backend is None:
            raise PgfRuntimeUnavailableError(
                self.last_error or "PGF runtime is unavailable."
            )
        concrete = self.resolve_concrete_name(concrete_language)
        if concrete is None:
            raise PgfConcreteLanguageNotFoundError(concrete_language)

        if self._backend == "python_pgf":
            if self._grammar is None:
                raise PgfRuntimeUnavailableError("Python PGF grammar is unavailable.")
            if isinstance(expr, str):
                try:
                    expr = pgf.readExpr(expr) if pgf is not None else expr
                except Exception as exc:
                    raise ValueError(f"Invalid GF expression: {exc}") from exc
            return str(self._grammar.languages[concrete].linearize(expr))

        if self._backend == "gf_cli":
            return self._linearize_cli(str(expr), concrete)

        raise PgfRuntimeUnavailableError("Unknown PGF runtime backend.")


__all__ = [
    "PgfRuntime",
    "PgfRuntimeUnavailableError",
    "PgfConcreteLanguageNotFoundError",
]
